# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>

# Application
PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public application origin used in password reset links
APP_BASE_URL=http://localhost:5000

# First-Administrator Bootstrap Token
# Required when registering the initial hospital admin account when 0 hospitals exist.
# ADMIN_SETUP_TOKEN=generate-a-strong-random-token-min-32-chars

# Vercel Blob storage (optional, used for public avatars when deployed on Vercel)
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# SMTP email service (required for password-reset email delivery)
# Gmail: enable 2-Step Verification and generate an App Password at
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=BloodMitra <yourname@gmail.com>

# Mailtrap / SendGrid / AWS SES / other SMTP providers:
# SMTP_HOST=your-provider-smtp-host
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=BloodMitra <verified-sender@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BloodMitra <noreply@yourdomain.com>
